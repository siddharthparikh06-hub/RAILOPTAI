# ==========================================
# RAILOPT AI Frontend .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnpm
/.yarn

# Production build outputs
/.next/
/out/
/build
/dist

# Environment local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
